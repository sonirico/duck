Output "docs/vhs/demo.gif"

Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 700
Set Theme "Catppuccin Mocha"
Set TypingSpeed 75ms

Type "./duck"
Enter
Sleep 2s

Type "j"
Sleep 2s

Type "j"
Sleep 3s

Type "j"
Sleep 2s

Type "j"
Sleep 2s

Type "j"
Sleep 2s

Type "G"
Sleep 2s

Type "g"
Sleep 2s

Type "q"
Sleep 1s
