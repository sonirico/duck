Output "docs/vhs/logs.gif"

Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 700
Set Theme "Catppuccin Mocha"
Set TypingSpeed 75ms

Type "./duck"
Enter
Sleep 2s

Type "j"
Sleep 1s
Type "j"
Sleep 1s

Sleep 5s

Tab
Sleep 1s

Type "k"
Sleep 500ms
Type "k"
Sleep 500ms
Type "g"
Sleep 1s

Type "G"
Sleep 2s

Type "q"
Sleep 1s
